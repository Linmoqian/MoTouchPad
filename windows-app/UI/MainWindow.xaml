<Window x:Class="MoTouchPad.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoTouchPad"
        Width="620"
        Height="480"
        MinWidth="560"
        MinHeight="430"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="MoTouchPad" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Margin="0,7,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="14"
                       Text="将 Android 设备变成 Windows 触控板" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="22"
                CornerRadius="12"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9"
                             Fill="#FFB142" Margin="0,0,10,0" />
                    <TextBlock x:Name="StatusText"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Text="等待连接" />
                </StackPanel>

                <CheckBox x:Name="ExperimentalDriverCheckBox"
                          Grid.Column="4"
                          VerticalAlignment="Center"
                          Foreground="{StaticResource MutedBrush}"
                          Content="实验性 VHF"
                          ToolTip="仅启用 VHF 驱动，不会同时提交鼠标兼容输入"
                          Click="ExperimentalDriverCheckBox_OnClick" />

                <TextBox x:Name="IpAddressTextBox"
                         Grid.Row="2"
                         Text="192.168.1.100"
                         ToolTip="Android 设备上显示的 IP 地址"
                         KeyDown="IpAddressTextBox_OnKeyDown" />
                <Button x:Name="ConnectButton"
                        Grid.Row="2"
                        Grid.Column="2"
                        MinWidth="112"
                        Click="ConnectButton_OnClick"
                        Content="连接" />
                <Button x:Name="UsbConnectButton"
                        Grid.Row="2"
                        Grid.Column="4"
                        MinWidth="112"
                        Background="#263245"
                        Foreground="{StaticResource TextBrush}"
                        Click="UsbConnectButton_OnClick"
                        Content="USB 连接" />
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Padding="22"
                CornerRadius="12"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="运行状态" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock x:Name="DriverStatusText"
                               DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource MutedBrush}"
                               Text="正在检测驱动…" />
                </DockPanel>
                <TextBox x:Name="LogTextBox"
                         Grid.Row="2"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Padding="0"
                         Background="Transparent"
                         Foreground="{StaticResource MutedBrush}"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
    </Grid>
</Window>
